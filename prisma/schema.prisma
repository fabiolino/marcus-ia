// Schéma de données de Marcus IA.
// L'adresse de la base n'est pas ici : elle est dans prisma.config.ts (règle de Prisma 7).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
}
